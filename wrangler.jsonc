{
  "services": [{"binding":"YU_ZORA_ERROR_PAGES","service":"yu-zora-main"}],
  "name": "kyou-nani-taberu",
  "main": "worker/shared-404/index.mjs",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "yu-zora.com/tools/kyou-nani-taberu", "zone_name": "yu-zora.com" },
    { "pattern": "yu-zora.com/tools/kyou-nani-taberu/*", "zone_name": "yu-zora.com" }
  ]
}
